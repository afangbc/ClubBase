# Comma-separated emails of the people who run ClubHub. These accounts get the
# owner console, which is the only place a school admin can be approved and the
# only place a school can be created. Owner is never stored in the database and
# can never be granted through the website — removing an address here revokes it
# on the next request. Required: with this unset, nobody can approve an admin.
CLUBHUB_OWNER_EMAILS=you@example.com

# Temporary bootstrap: accounts signing up with these addresses become an active
# admin of the default school straight away, skipping the request queue and the
# school-domain rule. Handy before an owner is around to approve the first
# admin. Clear it once the request queue is in use — accounts already created
# keep their campus until an owner revokes them.
CLUBHUB_ADMIN_EMAILS=

# Transactional email for the six-digit sign-up confirmation codes. Required in
# production: without both values set, a production deployment refuses to send
# and nobody can finish signing up. In local development the code is printed to
# the terminal running the dev server instead.
RESEND_API_KEY=
CLUBHUB_FROM_EMAIL=ClubHub <verify@your-domain.example>

# Added automatically when the Upstash Redis integration is connected to Vercel.
# ClubHub speaks Redis over HTTPS, so it needs these REST values — not the
# redis:// connection string (REDIS_URL) the same integrations also publish.
# KV_REST_API_URL and KV_REST_API_TOKEN are accepted as equivalents, since
# Vercel's Redis and KV marketplace entries inject those names instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional when multiple ClubHub installations share one Redis database.
CLUBHUB_REDIS_KEY=clubhub:database:v1
